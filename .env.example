NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버에서 관리자 기능으로 Supabase를 수정할 때 사용하는 비공개 키
SUPABASE_SERVICE_ROLE_KEY=

# 실제 배포 주소 (예: https://www.example.com)
NEXT_PUBLIC_SITE_URL=

# 검색엔진 구조화 데이터에 표시할 사업장 정보
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_BUSINESS_ADDRESS=

# 카카오맵 JavaScript 키
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=

# 관리자 로그인 비밀번호
ADMIN_PASSWORD=

# 관리자 로그인 쿠키 서명용 긴 임의 문자열
ADMIN_SESSION_SECRET=

# 네이버 매물 -> 홈페이지 자동등록 동기화
# 외부 자동화 프로그램이 /api/sync/naver 호출 시 사용하는 긴 임의 문자열
NAVER_SYNC_SECRET=
# 홈페이지 자동등록을 허용할 우리 중개업소 상호명. 여러 개면 쉼표로 구분
NAVER_SYNC_ALLOWED_REALTORS=백조현대부동산중개

# Google Search Console API (서비스 계정)
# Search Console 속성에 서비스 계정 이메일을 사용자로 추가해야 함
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# 서비스 계정 JSON의 private_key 값. Vercel에서는 \n 형태 그대로 입력 가능
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# 예: https://www.baekjohd.com/ 또는 sc-domain:baekjohd.com
GOOGLE_SEARCH_CONSOLE_SITE_URL=

# Resend 문의 답변 이메일 발송 설정
RESEND_API_KEY=
# 예: 백조현대부동산중개 <reply@example.com>
RESEND_FROM_EMAIL=
# 고객이 이메일에 회신할 때 받을 주소 (선택)
RESEND_REPLY_TO_EMAIL=
